{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["eslint.config.js", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build", "//#lint:tooling", "//#format:check"]
    },
    "test": {
      "dependsOn": ["^build", "//#test:tooling"]
    },
    "//#lint:tooling": {
      "inputs": [
        "eslint.config.js",
        "tsconfig.base.json",
        "package.json",
        "tooling/**"
      ]
    },
    "//#format:check": {
      "inputs": [
        ".prettierrc",
        ".prettierignore",
        ".gitignore",
        "package.json",
        "**",
        "!**/*.md",
        "!**/node_modules/**",
        "!**/dist/**",
        "!.turbo/**",
        "!**/.turbo/**",
        "!_bmad/**",
        "!_bmad-output/**",
        "!.claude/**"
      ]
    },
    "//#test:tooling": {
      "inputs": [
        "eslint.config.js",
        "package.json",
        ".npmrc",
        ".nvmrc",
        "tooling/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*-spec.ts",
        "**/*-spec.tsx"
      ]
    }
  }
}
