# Staged files only (lint-staged config in package.json): eslint --fix, then
# prettier --write. The full suite stays in `pnpm turbo build lint test`.

# Default shells may resolve an older Node without pnpm (and engine-strict
# refuses it), so load nvm and the .nvmrc version when nvm is installed.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  nvm use --silent || echo "pre-commit: 'nvm use' failed; using $(node -v 2>/dev/null || echo 'no node')" >&2
fi

pnpm exec lint-staged
